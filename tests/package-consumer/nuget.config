<?xml version="1.0" encoding="utf-8"?>
<!--
  The NuGet sources of the package consumer: WinXL from packages/, the folder the
  fresh package is put into, and nothing else from there; everything WinXL depends
  on from nuget.org. The mapping keeps WinXL off nuget.org, so that the consumer
  builds the package just made and not one published under a lower version.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="WinXL" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
