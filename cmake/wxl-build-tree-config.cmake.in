# ---- wxl package configuration file (build tree) ----
#
# Generated from cmake/wxl-build-tree-config.cmake.in into wxl's own build
# directory. It makes an un-installed build usable directly:
#
#     find_package(wxl CONFIG REQUIRED PATHS "<wxl-build-dir>")
#
# The same contract as the installed configuration file, minus the
# @PACKAGE_INIT@ preamble (there is no relocatable prefix here): one package,
# the targets export(EXPORT ...) writes, and no components.

if(NOT DEFINED CMAKE_EXPERIMENTAL_CXX_IMPORT_STD)
    message(FATAL_ERROR
        "\n[ERROR]: wxl needs CMake's experimental `import std;` support.\n"
        "Add this ABOVE project() in your top-level CMakeLists.txt:\n"
        "\n"
        "    set(CMAKE_EXPERIMENTAL_CXX_IMPORT_STD \"@WXL_IMPORT_STD_UUID@\")\n"
    )
endif()

#if(CMAKE_GENERATOR MATCHES "Visual Studio")
#    message(FATAL_ERROR
#        "\n[ERROR]: wxl cannot be consumed from the Visual Studio generators.\n"
#        "Use \"Ninja\" or \"Ninja Multi-Config\"; current generator: ${CMAKE_GENERATOR}\n"
#    )
#endif()

include("${CMAKE_CURRENT_LIST_DIR}/wxl-targets.cmake")

include("@WXL_SOURCE_CMAKE_DIR@/wxl_helpers.cmake")

# check_required_components() lives in the @PACKAGE_INIT@ preamble of an
# installed config, which this file does not have -- so the same rule is spelled
# out explicitly here: the package has no components to ask for.
foreach(_wxl_comp IN LISTS wxl_FIND_COMPONENTS)
    if(wxl_FIND_REQUIRED_${_wxl_comp})
        set(wxl_FOUND FALSE)
        set(wxl_NOT_FOUND_MESSAGE "wxl has no component '${_wxl_comp}': the package is one")
        return()
    endif()
endforeach()
unset(_wxl_comp)
